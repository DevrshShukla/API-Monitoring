# Environment Configuration Baseline
NODE_ENV=development
PORT=5000

# MongoDB & Redis
MONGODB_URI=mongodb://localhost:27017/api-monitoring
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_ACCESS_SECRET=dev-access-secret-32-chars-minimum-length-needed-here
JWT_REFRESH_SECRET=dev-refresh-secret-32-chars-minimum-length-needed-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30

# Encryption Key (32 bytes hex or base64 for AES-256-GCM)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Client URLs & CORS
APP_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Monitoring Defaults & Limits
MONITOR_INTERVAL_SECONDS=60
MONITOR_TIMEOUT_MS=10000
MAX_RESPONSE_BYTES=1048576
MAX_REDIRECTS=0
FAILURES_TO_DOWN=3
LATENCY_DEGRADED_MS=2000
ANALYTICS_DEFAULT_RANGE_DAYS=7
CHECK_RETENTION_DAYS=30
INCIDENT_RETENTION_DAYS=365
NOTIFICATION_COOLDOWN_MINUTES=15
ALLOWED_MONITOR_PORTS=80,443

# Logging
LOG_LEVEL=info

# SMTP Configuration (Optional in development)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=test-user
SMTP_PASS=test-password
SMTP_FROM=alerts@apimonitor.local
